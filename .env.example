# DR Sync Configuration — Environment Variables
# Use this as a template for exported variables; scripts do not load .env automatically.
# Setting any DR_SYNC_* variable selects environment configuration over common.py.

# Cloud provider: aws, azure, or gcp
DR_SYNC_CLOUD_TYPE=azure

# Local development: configure two Databricks CLI profiles. Profiles may use
# OAuth U2M/M2M and keep credentials out of this file.
DR_SYNC_SOURCE_PROFILE=SOURCE
DR_SYNC_TARGET_PROFILE=TARGET

# Automation: omit the profiles and let the Databricks SDK unified-auth chain
# consume DATABRICKS_HOST, DATABRICKS_AUTH_TYPE and the platform's OIDC token.
# The federated service principal must be assigned to both workspaces for scripts
# that open source and target clients in one process. PATs are legacy-only fallbacks:
# DR_SYNC_SOURCE_HOST=https://<primary-workspace-hostname>
# DR_SYNC_SOURCE_TOKEN=<secret-injected-at-runtime>
# DR_SYNC_TARGET_HOST=https://<secondary-workspace-hostname>
# DR_SYNC_TARGET_TOKEN=<secret-injected-at-runtime>

# Catalogs to replicate (comma-separated)
DR_SYNC_CATALOGS_TO_COPY=my-catalog1,my-catalog2

# Mapping file paths
DR_SYNC_CRED_MAPPING_FILE=data/azure_cred_mapping.csv
DR_SYNC_LOC_MAPPING_FILE=data/ext_location_mapping.csv
DR_SYNC_CATALOG_MAPPING_FILE=data/catalog_mapping.csv
DR_SYNC_SCHEMA_MAPPING_FILE=data/schema_mapping.csv

# Execution settings
DR_SYNC_LANDING_ZONE_URL=path/to/storage/
DR_SYNC_NUM_EXEC=4
DR_SYNC_WAREHOUSE_SIZE=Small
DR_SYNC_RESPONSE_BACKOFF=0.5
DR_SYNC_METASTORE_ID=<secondary-metastore-id>
DR_SYNC_MANIFEST_NAME=manifest

# Runtime flags
DR_SYNC_DRY_RUN=false
